{
  "schema": 1,
  "id": "jelly",
  "name": "ぷるぷる",
  "stage": "motion",
  "group": "動き",
  "keywords": ["jelly", "wiggle", "ぷるぷる", "ゼリー", "弾む"],
  "amountMode": "scale",
  "scaleParams": ["amp", "wobble"],
  "timeDependent": true,
  "sizeRule": "same",
  "params": [
    {"key": "amp", "label": "伸び縮み", "type": "float", "min": 0, "max": 50, "default": 12, "step": 1, "unit": "%"},
    {"key": "wobble", "label": "ゆがみ", "type": "float", "min": 0, "max": 100, "default": 40, "step": 1, "unit": "%"}
  ],
  "passes": [
    {"id": "main", "shader": "jelly", "inputs": ["src"], "scale": 1,
     "bind": {"amp": "amp", "wobble": "wobble", "t": "$t", "cycles": "$cycles", "phase": "$phase", "wave": "$wave", "frame": "$frame"}}
  ]
}
