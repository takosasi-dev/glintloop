{
  "schema": 1,
  "id": "fade",
  "name": "フェード",
  "stage": "look",
  "group": "基本",
  "keywords": ["フェード", "fade", "lift", "drop", "マット"],
  "amountMode": "mix",
  "timeDependent": false,
  "sizeRule": "same",
  "params": [
    {"key": "lift", "label": "黒の持ち上げ", "type": "float", "min": 0, "max": 40, "default": 10, "unit": "%"},
    {"key": "drop", "label": "白の引き下げ", "type": "float", "min": 0, "max": 40, "default": 0, "unit": "%"}
  ],
  "passes": [
    {"id": "main", "shader": "fade", "inputs": ["src"], "scale": 1, "bind": {"lift": "lift", "drop": "drop", "amount": "$amount"}}
  ]
}
