{
  "schema": 1,
  "id": "levels",
  "name": "レベル",
  "stage": "look",
  "group": "基本",
  "keywords": ["レベル", "levels", "ガンマ", "gamma", "黒点", "白点"],
  "amountMode": "mix",
  "timeDependent": false,
  "sizeRule": "same",
  "params": [
    {"key": "black", "label": "黒点", "type": "float", "min": 0, "max": 90, "default": 0, "unit": "%"},
    {"key": "white", "label": "白点", "type": "float", "min": 10, "max": 100, "default": 100, "unit": "%"},
    {"key": "gamma", "label": "ガンマ", "type": "float", "min": 0.2, "max": 5, "default": 1.0}
  ],
  "passes": [
    {"id": "main", "shader": "levels", "inputs": ["src"], "scale": 1, "bind": {"black": "black", "white": "white", "gamma": "gamma", "amount": "$amount"}}
  ]
}
