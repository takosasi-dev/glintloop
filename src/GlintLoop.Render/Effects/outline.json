{
  "schema": 1,
  "id": "outline",
  "name": "縁取り",
  "stage": "finish",
  "group": "縁と文字",
  "keywords": ["outline", "stroke", "縁", "フチ", "ふちどり"],
  "amountMode": "mix",
  "timeDependent": false,
  "sizeRule": "same",
  "params": [
    {"key": "width", "label": "太さ", "type": "float", "min": 0, "max": 80, "default": 12, "step": 0.1, "unit": "‰"},
    {"key": "pos", "label": "位置", "type": "enum", "default": "outside",
     "options": [{"value": "outside", "label": "外側"}, {"value": "inside", "label": "内側"}, {"value": "center", "label": "中央"}]},
    {"key": "color", "label": "色", "type": "color", "default": "#FFFFFFFF"},
    {"key": "soft", "label": "ぼかし", "type": "float", "min": 0, "max": 30, "default": 0, "step": 0.1, "unit": "‰"}
  ],
  "passes": [
    {"id": "rows", "shader": "edge_rows", "inputs": ["src"], "scale": 1,
     "bind": {"shift": "width", "feather": "soft", "shortSide": "$shortSide"}},
    {"id": "main", "shader": "outline", "inputs": ["src", "pass:rows"], "scale": 1,
     "bind": {"width": "width", "pos": "pos", "color": "color", "soft": "soft", "shortSide": "$shortSide"}}
  ]
}
