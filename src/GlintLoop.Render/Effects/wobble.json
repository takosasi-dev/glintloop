{
  "schema": 1,
  "id": "wobble",
  "name": "ゆらゆら",
  "stage": "motion",
  "group": "動き",
  "keywords": ["wobble", "sway", "ゆらゆら", "揺れる", "振り子"],
  "amountMode": "scale",
  "scaleParams": ["angle"],
  "timeDependent": true,
  "sizeRule": "same",
  "params": [
    {"key": "angle", "label": "角度", "type": "float", "min": 0, "max": 45, "default": 8, "step": 0.1, "unit": "deg"},
    {"key": "pivot", "label": "支点", "type": "point", "default": {"x": 0.5, "y": 0.9}}
  ],
  "passes": [
    {"id": "main", "shader": "wobble", "inputs": ["src"], "scale": 1,
     "bind": {"angle": "angle", "pivot": "pivot", "t": "$t", "cycles": "$cycles", "phase": "$phase", "wave": "$wave", "frame": "$frame"}}
  ]
}
