{
  "schema": 1,
  "id": "hover",
  "name": "ふわふわ",
  "stage": "motion",
  "group": "動き",
  "keywords": ["hover", "float", "ふわふわ", "浮く", "ただよう"],
  "amountMode": "scale",
  "scaleParams": ["amp", "tilt"],
  "timeDependent": true,
  "sizeRule": "same",
  "params": [
    {"key": "amp", "label": "振れ幅", "type": "float", "min": 0, "max": 100, "default": 20, "step": 1, "unit": "‰"},
    {"key": "tilt", "label": "傾き", "type": "float", "min": 0, "max": 15, "default": 2, "step": 0.1, "unit": "deg"}
  ],
  "passes": [
    {"id": "main", "shader": "hover", "inputs": ["src"], "scale": 1,
     "bind": {"amp": "amp", "tilt": "tilt", "t": "$t", "cycles": "$cycles", "phase": "$phase", "wave": "$wave", "frame": "$frame"}}
  ]
}
