{
  "schema": 1,
  "id": "exposure",
  "name": "露出",
  "stage": "look",
  "group": "基本",
  "keywords": ["明るさ", "ev", "brightness"],
  "amountMode": "mix",
  "timeDependent": false,
  "sizeRule": "same",
  "params": [
    {"key": "ev", "label": "露出", "type": "float", "min": -3, "max": 3, "default": 0, "step": 0.01, "unit": "EV"}
  ],
  "passes": [
    {"id": "main", "shader": "exposure", "inputs": ["src"], "scale": 1, "bind": {"ev": "ev", "amount": "$amount"}}
  ]
}
