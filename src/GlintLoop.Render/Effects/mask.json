{
  "schema": 1,
  "id": "mask",
  "name": "形で抜く",
  "stage": "shape",
  "group": "輪郭",
  "keywords": ["mask", "shape", "円", "角丸", "ハート", "星", "六角形", "squircle"],
  "amountMode": "none",
  "timeDependent": false,
  "sizeRule": "same",
  "params": [
    {"key": "kind", "label": "形", "type": "enum", "default": "roundrect",
     "options": [
       {"value": "roundrect", "label": "角丸"},
       {"value": "circle", "label": "円"},
       {"value": "ellipse", "label": "楕円"},
       {"value": "squircle", "label": "スクワークル"},
       {"value": "heart", "label": "ハート"},
       {"value": "star", "label": "星"},
       {"value": "hexagon", "label": "六角形"}
     ]},
    {"key": "size", "label": "大きさ", "type": "float", "min": 20, "max": 100, "default": 100, "step": 0.1, "unit": "%"},
    {"key": "radius", "label": "角の半径", "type": "float", "min": 0, "max": 500, "default": 150, "step": 1, "unit": "‰"},
    {"key": "inner", "label": "星の内側", "type": "float", "min": 20, "max": 80, "default": 45, "step": 0.1, "unit": "%"},
    {"key": "feather", "label": "ぼかし", "type": "float", "min": 0, "max": 30, "default": 0, "step": 0.1, "unit": "‰"},
    {"key": "center", "label": "中心", "type": "point", "default": {"x": 0.5, "y": 0.5}},
    {"key": "invert", "label": "反転", "type": "bool", "default": false}
  ],
  "passes": [
    {"id": "main", "shader": "mask", "inputs": ["src"], "scale": 1,
     "bind": {"kind": "kind", "size": "size", "radius": "radius", "inner": "inner", "feather": "feather",
              "center": "center", "invert": "invert", "texel": "$texel"}}
  ]
}
