{
  "schema": 1,
  "id": "emboss",
  "name": "エンボス",
  "stage": "finish",
  "group": "光",
  "keywords": ["emboss", "relief", "浮き彫り", "凹凸"],
  "amountMode": "mix",
  "timeDependent": false,
  "sizeRule": "same",
  "params": [
    {"key": "mode", "label": "色の扱い", "type": "enum", "default": "gray",
     "options": [{"value": "gray", "label": "灰色"}, {"value": "color", "label": "カラー"}]},
    {"key": "angle", "label": "光の向き", "type": "angle", "min": 0, "max": 360, "default": 135, "step": 1, "unit": "deg"},
    {"key": "depth", "label": "深さ", "type": "float", "min": 0, "max": 40, "default": 6, "step": 0.1, "unit": "‰"},
    {"key": "soft", "label": "なめらかさ", "type": "float", "min": 0, "max": 10, "default": 1, "step": 0.1, "unit": "‰"}
  ],
  "passes": [
    {"id": "e", "shader": "emboss_e", "inputs": ["src"], "scale": 1},
    {"id": "h", "shader": "blur_h", "inputs": ["pass:e"], "scale": 1, "bind": {"radius": "soft", "shortSide": "$shortSide"}},
    {"id": "v", "shader": "blur_v", "inputs": ["pass:h"], "scale": 1, "bind": {"radius": "soft", "shortSide": "$shortSide"}},
    {"id": "main", "shader": "emboss", "inputs": ["src", "pass:v"], "scale": 1,
     "bind": {"mode": "mode", "angle": "angle", "depth": "depth", "shortSide": "$shortSide"}}
  ]
}
