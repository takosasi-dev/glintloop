{
  "schema": 1,
  "id": "grain",
  "name": "グレイン",
  "stage": "finish",
  "group": "光",
  "keywords": ["grain", "noise", "粒子", "ノイズ", "フィルム"],
  "amountMode": "scale",
  "scaleParams": ["strength"],
  "timeDependent": false,
  "sizeRule": "same",
  "params": [
    {"key": "strength", "label": "粒の強さ", "type": "float", "min": 0, "max": 100, "default": 25, "step": 1, "unit": "%"},
    {"key": "size", "label": "粒の大きさ", "type": "float", "min": 0.5, "max": 20, "default": 2, "step": 0.1, "unit": "‰"},
    {"key": "mono", "label": "単色", "type": "bool", "default": true}
  ],
  "passes": [
    {"id": "main", "shader": "grain", "inputs": ["src"], "scale": 1,
     "bind": {"strength": "strength", "size": "size", "mono": "mono", "shortSide": "$shortSide", "seed": "$seed", "salt": "$salt"}}
  ]
}
