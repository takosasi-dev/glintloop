{
  "schema": 1,
  "id": "tone",
  "name": "影とハイライト",
  "stage": "look",
  "group": "基本",
  "keywords": ["影", "ハイライト", "shadows", "highlights", "tone"],
  "amountMode": "mix",
  "timeDependent": false,
  "sizeRule": "same",
  "params": [
    {"key": "shadows", "label": "影", "type": "float", "min": -100, "max": 100, "default": 0, "unit": "%"},
    {"key": "highlights", "label": "ハイライト", "type": "float", "min": -100, "max": 100, "default": 0, "unit": "%"}
  ],
  "passes": [
    {"id": "main", "shader": "tone", "inputs": ["src"], "scale": 1, "bind": {"shadows": "shadows", "highlights": "highlights", "amount": "$amount"}}
  ]
}
