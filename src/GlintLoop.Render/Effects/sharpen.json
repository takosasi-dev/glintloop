{
  "schema": 1,
  "id": "sharpen",
  "name": "シャープ",
  "stage": "finish",
  "group": "ぼかし",
  "keywords": ["sharpen", "unsharp mask", "鮮明", "くっきり", "アンシャープ"],
  "amountMode": "scale",
  "scaleParams": ["strength"],
  "timeDependent": false,
  "sizeRule": "same",
  "params": [
    {"key": "radius", "label": "半径", "type": "float", "min": 0, "max": 20, "default": 3, "step": 0.1, "unit": "‰"},
    {"key": "strength", "label": "鮮明さ", "type": "float", "min": 0, "max": 300, "default": 100, "step": 1, "unit": "%"},
    {"key": "threshold", "label": "しきい値", "type": "float", "min": 0, "max": 50, "default": 0, "step": 0.1, "unit": ""}
  ],
  "passes": [
    {"id": "h", "shader": "blur_h", "inputs": ["src"], "scale": 1, "bind": {"radius": "radius", "shortSide": "$shortSide"}},
    {"id": "v", "shader": "blur_v", "inputs": ["pass:h"], "scale": 1, "bind": {"radius": "radius", "shortSide": "$shortSide"}},
    {"id": "main", "shader": "sharpen", "inputs": ["src", "pass:v"], "scale": 1, "bind": {"strength": "strength", "threshold": "threshold"}}
  ]
}
