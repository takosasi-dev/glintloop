{
  "schema": 1,
  "id": "grainmove",
  "name": "動くグレイン",
  "stage": "motion",
  "group": "粒",
  "keywords": ["grain", "film", "noise", "グレイン", "フィルム", "ノイズ"],
  "amountMode": "scale",
  "scaleParams": ["strength"],
  "timeDependent": true,
  "noWave": true,
  "sizeRule": "same",
  "params": [
    {"key": "strength", "label": "粒の強さ", "type": "float", "min": 0, "max": 100, "default": 25, "step": 1, "unit": "%"},
    {"key": "size", "label": "粒の大きさ", "type": "float", "min": 0.5, "max": 20, "default": 2, "step": 0.1, "unit": "‰"},
    {"key": "mono", "label": "単色", "type": "bool", "default": true},
    {"key": "rate", "label": "入れ替わりの回数", "type": "int", "min": 1, "max": 24, "default": 6}
  ],
  "passes": [
    {"id": "main", "shader": "grainmove", "inputs": ["src"], "scale": 1,
     "bind": {"strength": "strength", "size": "size", "mono": "mono", "rate": "rate", "shortSide": "$shortSide", "t": "$t", "cycles": "$cycles", "phase": "$phase", "seed": "$seed", "salt": "$salt", "frame": "$frame"}}
  ]
}
