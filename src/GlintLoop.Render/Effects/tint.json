{
  "schema": 1,
  "id": "tint",
  "name": "色の重ね",
  "stage": "look",
  "group": "重ね",
  "keywords": ["色かぶり", "カラー", "tint", "overlay", "softlight"],
  "amountMode": "mix",
  "timeDependent": false,
  "sizeRule": "same",
  "params": [
    {"key": "color", "label": "色", "type": "color", "default": "#FF8040FF"},
    {"key": "mode", "label": "重ね方", "type": "enum", "default": "softlight",
     "options": [{"value": "normal", "label": "通常"}, {"value": "multiply", "label": "乗算"}, {"value": "screen", "label": "スクリーン"}, {"value": "overlay", "label": "オーバーレイ"}, {"value": "softlight", "label": "ソフトライト"}]},
    {"key": "opacity", "label": "不透明度", "type": "float", "min": 0, "max": 100, "default": 50, "unit": "%"}
  ],
  "passes": [
    {"id": "main", "shader": "tint", "inputs": ["src"], "scale": 1, "bind": {"color": "color", "mode": "mode", "opacity": "opacity"}}
  ]
}
