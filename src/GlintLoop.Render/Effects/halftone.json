{
  "schema": 1,
  "id": "halftone",
  "name": "ハーフトーン",
  "stage": "finish",
  "group": "ひずみ",
  "keywords": ["halftone", "網点", "ドット", "印刷", "cmy"],
  "amountMode": "mix",
  "timeDependent": false,
  "sizeRule": "same",
  "params": [
    {"key": "mode", "label": "方式", "type": "enum", "default": "mono",
     "options": [{"value": "mono", "label": "単色"}, {"value": "cmy", "label": "三原色"}]},
    {"key": "size", "label": "点の間隔", "type": "float", "min": 5, "max": 100, "default": 25, "step": 0.1, "unit": "‰"},
    {"key": "angle", "label": "角度", "type": "angle", "min": 0, "max": 90, "default": 45, "step": 1, "unit": "deg"},
    {"key": "ink", "label": "インクの色", "type": "color", "default": "#14121FFF", "visibleWhen": {"mode": ["mono"]}},
    {"key": "paper", "label": "紙の色", "type": "color", "default": "#F2F0E6FF", "visibleWhen": {"mode": ["mono"]}}
  ],
  "passes": [
    {"id": "h", "shader": "halftone_h", "inputs": ["src"], "scale": 1, "bind": {"size": "size", "shortSide": "$shortSide"}},
    {"id": "v", "shader": "halftone_v", "inputs": ["pass:h"], "scale": 1, "bind": {"size": "size", "shortSide": "$shortSide"}},
    {"id": "main", "shader": "halftone", "inputs": ["src", "pass:v"], "scale": 1,
     "bind": {"mode": "mode", "size": "size", "angle": "angle", "ink": "ink", "paper": "paper", "shortSide": "$shortSide", "texel": "$texel"}}
  ]
}
