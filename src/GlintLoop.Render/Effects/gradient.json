{
  "schema": 1,
  "id": "gradient",
  "name": "グラデーション重ね",
  "stage": "look",
  "group": "重ね",
  "keywords": ["グラデーション", "gradient", "色", "overlay", "softlight"],
  "amountMode": "mix",
  "timeDependent": false,
  "sizeRule": "same",
  "params": [
    {"key": "c0", "label": "始めの色", "type": "color", "default": "#FF5FA2FF"},
    {"key": "c1", "label": "終わりの色", "type": "color", "default": "#5F7BFFFF"},
    {"key": "angle", "label": "角度", "type": "angle", "min": -180, "max": 180, "default": 90, "unit": "deg"},
    {"key": "mode", "label": "重ね方", "type": "enum", "default": "softlight",
     "options": [{"value": "normal", "label": "通常"}, {"value": "multiply", "label": "乗算"}, {"value": "screen", "label": "スクリーン"}, {"value": "overlay", "label": "オーバーレイ"}, {"value": "softlight", "label": "ソフトライト"}]},
    {"key": "opacity", "label": "不透明度", "type": "float", "min": 0, "max": 100, "default": 60, "unit": "%"}
  ],
  "passes": [
    {"id": "main", "shader": "gradient", "inputs": ["src"], "scale": 1, "bind": {"c0": "c0", "c1": "c1", "angle": "angle", "mode": "mode", "opacity": "opacity", "texel": "$texel"}}
  ]
}
