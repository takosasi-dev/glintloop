<!-- ダークテーマのカラートークン(仕様書 §9.1)。キーはトークン名のパスカルケース、ブラシは末尾に Brush を付ける。 -->
<!-- Tokens.Light.xaml と同じキーの集合を持ち、テーマの切替でこの辞書ごと差し替える(AC-19 の (1))。 -->
<!-- 不透明度の指定(divider・scrim・drop-overlay)は、アルファを round(割合 × 255) にした値で書く。 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="BgBase">#FF16171B</Color>
  <Color x:Key="Surface1">#FF1E1F25</Color>
  <Color x:Key="Surface2">#FF272830</Color>
  <Color x:Key="Surface3">#FF31333D</Color>
  <Color x:Key="BorderStrong">#FF80839A</Color>
  <Color x:Key="TextPrimary">#FFF2F2F7</Color>
  <Color x:Key="TextSecondary">#FFB4B6C6</Color>
  <Color x:Key="Accent">#FF8E7BFF</Color>
  <Color x:Key="AccentHover">#FFA190FF</Color>
  <Color x:Key="AccentPressed">#FF7B67F0</Color>
  <Color x:Key="OnAccent">#FF101018</Color>
  <Color x:Key="AccentText">#FFB3A8FF</Color>
  <Color x:Key="FocusRing">#FFD9D4FF</Color>
  <Color x:Key="Danger">#FFFF7A7A</Color>
  <Color x:Key="Success">#FF5BE3A4</Color>
  <Color x:Key="Warning">#FFF7C45C</Color>

  <!-- 装飾の色: divider は #FFFFFF の 8%、scrim は #000000 の 50%、drop-overlay は accent の 12% -->
  <Color x:Key="Divider">#14FFFFFF</Color>
  <Color x:Key="Scrim">#80000000</Color>
  <Color x:Key="DropOverlay">#1F8E7BFF</Color>

  <!-- キャンバスの背景(FR-20)。ダークとライトで同じ -->
  <Color x:Key="CanvasChecker1">#FFFFFFFF</Color>
  <Color x:Key="CanvasChecker2">#FFCCCCCC</Color>
  <Color x:Key="CanvasBlack">#FF000000</Color>
  <Color x:Key="CanvasWhite">#FFFFFFFF</Color>
  <Color x:Key="CanvasGray">#FF808080</Color>

  <SolidColorBrush x:Key="BgBaseBrush" Color="{StaticResource BgBase}" />
  <SolidColorBrush x:Key="Surface1Brush" Color="{StaticResource Surface1}" />
  <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2}" />
  <SolidColorBrush x:Key="Surface3Brush" Color="{StaticResource Surface3}" />
  <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrong}" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHover}" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressed}" />
  <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccent}" />
  <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentText}" />
  <SolidColorBrush x:Key="FocusRingBrush" Color="{StaticResource FocusRing}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}" />
  <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource Divider}" />
  <SolidColorBrush x:Key="ScrimBrush" Color="{StaticResource Scrim}" />
  <SolidColorBrush x:Key="DropOverlayBrush" Color="{StaticResource DropOverlay}" />
  <SolidColorBrush x:Key="CanvasChecker1Brush" Color="{StaticResource CanvasChecker1}" />
  <SolidColorBrush x:Key="CanvasChecker2Brush" Color="{StaticResource CanvasChecker2}" />
  <SolidColorBrush x:Key="CanvasBlackBrush" Color="{StaticResource CanvasBlack}" />
  <SolidColorBrush x:Key="CanvasWhiteBrush" Color="{StaticResource CanvasWhite}" />
  <SolidColorBrush x:Key="CanvasGrayBrush" Color="{StaticResource CanvasGray}" />
</ResourceDictionary>
